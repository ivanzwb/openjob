{
  "name": "openjob",
  "version": "0.6.26",
  "description": "面试备考 Agent — 以一场具体面试为单位，诊断考点、编排计划、逐日推进",
  "license": "Apache-2.0",
  "author": "OpenJob <ivan.zwb@gmail.com>",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "sync:grammars": "node scripts/sync-grammars.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "smoke:grammars": "node scripts/sync-grammars.mjs && node scripts/smoke-treesitter.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "dev": "node scripts/generate-icons.mjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prepackage": "npm run sync:grammars && npm run icons && node scripts/ensure-nsis-cache.mjs",
    "predist": "npm run sync:grammars && npm run icons && node scripts/ensure-nsis-cache.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "ci": "npm run typecheck && npm run lint && npm run test && npm run smoke:grammars && npm run build && npm run smoke:app",
    "lint": "eslint .",
    "start": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "package": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "dist": "npm run build && node scripts/run-electron-builder.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tree-sitter-wasms": "^0.1.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@shikijs/langs": "4.4.2",
    "@shikijs/themes": "4.4.2",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "shiki": "^4.4.2",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.25.10",
    "word-extractor": "^1.0.4"
  }
}
