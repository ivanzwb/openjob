{
  "name": "openjob-workspace",
  "description": "面试备考 Agent — 以一场具体面试为单位，诊断考点、编排计划、逐日推进",
  "license": "Apache-2.0",
  "author": "OpenJob <ivan.zwb@gmail.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r --stream typecheck",
    "test": "vitest run",
    "lint": "eslint .",
    "dev": "pnpm --filter @openjob/desktop dev",
    "build": "pnpm --filter @openjob/desktop build",
    "start": "pnpm --filter @openjob/desktop start",
    "package": "pnpm --filter @openjob/desktop package",
    "dist": "pnpm --filter @openjob/desktop dist",
    "db:generate": "pnpm --filter @openjob/desktop db:generate",
    "smoke:grammars": "pnpm --filter @openjob/desktop smoke:grammars",
    "smoke:app": "pnpm --filter @openjob/desktop smoke:app",
    "pack:plugins": "node scripts/pack-plugins.mjs",
    "verify:plugins": "node scripts/pack-plugins.mjs && node scripts/verify-plugin-bundles.mjs dist-plugins",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run smoke:grammars && pnpm run build && pnpm run smoke:app"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
