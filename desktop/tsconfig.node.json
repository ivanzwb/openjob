{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@core/*": ["../core/src/*"],
      "@main/*": ["./src/main/*"],
      "@plugins": ["../plugins/index.ts"],
      "@plugins/*": ["../plugins/*"]
    }
  },
  // core 与 plugins 不进 include：它们各自的 tsconfig 负责自查。tsc 仍会顺着
  // import 把用到的 core 文件类型检出来，这里只是不替它们跑一遍全量。
  "include": [
    "src/main/**/*",
    "src/preload/**/*",
    "electron.vite.config.ts",
    "drizzle.config.ts",
    "vitest.config.ts"
  ]
}
