{
  "name": "@openjob/desktop",
  "version": "1.0.0-rc.1",
  "description": "OpenJob 桌面端（Electron）",
  "license": "Apache-2.0",
  "author": "OpenJob <ivan.zwb@gmail.com>",
  "//": "electron-builder 从 desktop/ 目录打包时找不到仓库根目录的 .git/config，发布到 GitHub Release 必须靠这里显式声明仓库（否则报 \"Cannot detect repository\"）",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivanzwb/openjob.git"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "//": "版本号的唯一来源：electron-builder 读它命名安装包，mobile/scripts/sync-version.mjs 从这里同步到 app.json，core/src/version.test.ts 盯住两端一致。",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "sync:grammars": "node scripts/sync-grammars.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "smoke:grammars": "node scripts/sync-grammars.mjs && node scripts/smoke-treesitter.mjs",
    "smoke:app": "node scripts/smoke-app.mjs",
    "dev": "node scripts/generate-icons.mjs && electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "prepackage": "npm run sync:grammars && npm run icons && node scripts/ensure-nsis-cache.mjs",
    "predist": "npm run sync:grammars && npm run icons && node scripts/ensure-nsis-cache.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "db:generate": "drizzle-kit generate",
    "package": "npm run build && node scripts/run-electron-builder.mjs --dir",
    "dist": "npm run build && node scripts/run-electron-builder.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@openjob/core": "workspace:*",
    "@shikijs/langs": "4.4.2",
    "@shikijs/themes": "4.4.2",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.16.1",
    "openai": "^7.4.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-qr-code": "^2.2.0",
    "shiki": "^4.4.2",
    "simple-git": "^3.36.0",
    "web-tree-sitter": "^0.25.10",
    "word-extractor": "^1.0.4"
  },
  "//": "sharp 的平台二进制（@img/sharp-*）是它的 optionalDependencies，electron-builder 26.x 不会收集传递级 optionalDependencies（github.com/electron-userland/electron-builder/issues/9737），直接导致打包后缺 sharp 运行时。把构建矩阵需要的平台包声明为应用自身的 optionalDependencies：pnpm 按 os/cpu 只在对应平台安装匹配包，electron-builder 才会把它们收进安装包。版本必须与 sharp@0.34.5 的 optionalDependencies 精确一致。",
  "optionalDependencies": {
    "@img/sharp-libvips-darwin-arm64": "1.2.4",
    "@img/sharp-libvips-darwin-x64": "1.2.4",
    "@img/sharp-libvips-linux-x64": "1.2.4",
    "@img/sharp-darwin-arm64": "0.34.5",
    "@img/sharp-darwin-x64": "0.34.5",
    "@img/sharp-linux-x64": "0.34.5",
    "@img/sharp-win32-x64": "0.34.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "drizzle-kit": "^0.31.10",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4.3.3",
    "tree-sitter-wasms": "^0.1.13"
  }
}
